# APEX-3 Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# NEVER share these values in logs, screenshots, or chat.

# === Runtime Mode (paper | live) ===
APEX3_MODE=paper

# === Zerodha Kite Connect Credentials ===
# Obtain from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Daily access token — generated each trading day via login flow.
# This must be refreshed before each session.
KITE_ACCESS_TOKEN=your_daily_access_token_here

# === Angel One SmartAPI Credentials (FREE Live Market Data Feed ONLY) ===
# Obtain from https://smartapi.angelone.in/
# IMPORTANT: Used ONLY for streaming live quotes and candles.
# NO orders are ever routed to Angel One. Orders execute exclusively on Zerodha.
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_CODE=your_angel_client_code_here
ANGEL_PIN=your_angel_pin_here
ANGEL_TOTP_SECRET=your_angel_totp_secret_here

# === Operator Dashboard Security ===
# Required for POST actions (/api/mode, /api/kill_switch, /api/flatten, /api/token)
DASHBOARD_API_TOKEN=replace_with_32_byte_random_hex_token

# === Telegram & Email Alert Notifications (Optional but Recommended) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=

# === Live Trading Gate ===
# MUST be explicitly set to "true" to enable real order placement.
# Default is false. Paper mode operates without this.
LIVE_TRADING_ENABLED=false

# === Static IP Confirmation ===
# Set to "true" only after you have configured your static IP
# with Zerodha at developers.kite.trade (required since 1 April 2026).
STATIC_IP_CONFIGURED=false

# === Regulatory Acknowledgement ===
# Set to "true" only after verifying your SEBI/NSE algo trading
# compliance status for your specific use case.
SEBI_COMPLIANCE_ACKNOWLEDGED=false
