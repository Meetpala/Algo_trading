# APEX-3 Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# NEVER share these values in logs, screenshots, or chat.

# === Zerodha Kite Connect Credentials ===
# Obtain from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Daily access token — generated each trading day via login flow.
# This must be refreshed before each session.
KITE_ACCESS_TOKEN=your_daily_access_token_here

# === Live Trading Gate ===
# MUST be explicitly set to "true" to enable real order placement.
# Default is false. Paper mode operates without this.
LIVE_TRADING_ENABLED=false

# === Static IP Confirmation ===
# Set to "true" only after you have configured your static IP
# with Zerodha at developers.kite.trade (required since 1 April 2026).
STATIC_IP_CONFIGURED=false

# === Regulatory Acknowledgement ===
# Set to "true" only after verifying your SEBI/NSE algo trading
# compliance status for your specific use case.
SEBI_COMPLIANCE_ACKNOWLEDGED=false
